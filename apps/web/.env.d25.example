# Copy these PUBLIC Firebase web config values to apps/web/.env.production.local.
# Do NOT put Razorpay secrets or Firebase Admin service-account credentials here.
VITE_D25_FIREBASE_API_KEY=REPLACE_WITH_YOUR_FIREBASE_WEB_API_KEY
VITE_D25_API_BASE=https://asia-south1-YOUR_PROJECT_ID.cloudfunctions.net/d25Api

# Browser-only Google Identity Services / admin portal PUBLIC settings.
# Configure Google provider and authorized domain in Firebase console.
VITE_D25_GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_WEB_OAUTH_CLIENT_ID
VITE_D25_ADMIN_API_BASE=https://asia-south1-YOUR_PROJECT_ID.cloudfunctions.net/d25Admin

# Protected server compute endpoint: Cloud Function d25Compute, no keys.
VITE_D25_COMPUTE_API_BASE=https://asia-south1-YOUR_PROJECT_ID.cloudfunctions.net/d25Compute
