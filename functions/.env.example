# Non-secret project-specific configuration. Copy into functions/.env.<projectId> after creating a dedicated Firebase project.
# Razorpay Test Mode: create a monthly plan with amount=50000 paise (₹500).
D25_RAZORPAY_PLAN_ID_TEST=plan_REPLACE_WITH_TEST_PLAN_ID
# Optional additional allowed origin for website/browser login (comma separated).
D25_ALLOWED_ORIGINS=https://your-approved-domain.example

# Admin browser portal origin must match exact deployed HTTPS origin.
D25_ADMIN_ALLOWED_ORIGINS=https://your-approved-domain.example

# Comma-separated approved origins for subscriber compute HTTP requests.
D25_COMPUTE_ALLOWED_ORIGINS=https://your-approved-domain.example
